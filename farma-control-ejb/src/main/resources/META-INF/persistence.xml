<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="farmaPU" transaction-type="JTA">

        <!-- Aponta para o DataSource configurado no WildFly -->
        <jta-data-source>java:jboss/datasources/PostgresDS</jta-data-source>

        <properties>
            <!-- Propriedades do Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Mostra o SQL gerado no console do WildFly -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Atualiza o esquema do banco automaticamente ao subir a aplicação -->
            <!-- Opções: update, validate, create-drop -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>

    </persistence-unit>
</persistence>